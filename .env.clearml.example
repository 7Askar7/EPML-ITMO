# ClearML Server endpoints (external: web http://localhost:8090, api http://localhost:8008, files http://localhost:8091)
CLEARML_API_HOST=http://apiserver:8008
CLEARML_WEB_HOST=http://webserver:80
CLEARML_FILES_HOST=http://fileserver:8081

# Credentials (local dev defaults; replace with your keys from ClearML UI in prod)
CLEARML_API_ACCESS_KEY=devkey
CLEARML_API_SECRET_KEY=devsecret

# ClearML Agent defaults
CLEARML_AGENT_GIT_USER=
CLEARML_AGENT_GIT_PASS=
CLEARML_DOCKER_DEFAULT_IMAGE=python:3.11-slim
CLEARML_WORKER_NAME=epml-agent
CLEARML_QUEUE=services

# Optional notifications
CLEARML_SLACK_WEBHOOK=
